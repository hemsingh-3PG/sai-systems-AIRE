# Build-context exclusions for the AI image (podman build --ignorefile).
# Kept here rather than as a .dockerignore inside PacEHR_AI so the repo stays
# untouched. Every env file holds secrets and must never enter an image layer;
# the container gets its settings as environment variables at run time.
.env*
!.env.example
local.settings.json
node_modules/
dist/
coverage/
.git
.vscode
.claude
*.log
.DS_Store
Dockerfile
.dockerignore
pipelines/
