# Build-context exclusions for the web image (podman build --ignorefile).
# Kept here rather than as a .dockerignore inside PacEHR so the repo stays
# untouched. node_modules is excluded deliberately: the image runs `npm ci`
# so the dependency tree matches package-lock.json exactly.
.git
.vscode
node_modules/
dist/
.angular/
docs/
e2e/
e2e-playwright/
release-risk-*/
playwright-report/
test-results/
*.log
*.md
