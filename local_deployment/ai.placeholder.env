# Non-secret placeholder settings for PacEHR_AI: enough for the service to start,
# nothing real is reachable. /health answers 200; /health/ready answers 503.
# Use:  AI_ENV_FILE=ai.placeholder.env ./deploy.sh --ai-only
# For a real run, fill in ../PacEHR_AI/.env.local and deploy without the override.
AZURE_OPENAI_ENDPOINT=https://placeholder.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_GPT_4_1_DEPLOYMENT=placeholder-gpt-4-1
AZURE_SQL_SERVER=placeholder.database.windows.net
AZURE_SQL_DATABASE=placeholder
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_AUDIENCE=00000000-0000-0000-0000-000000000000
AZURE_OPENAI_API_KEY=placeholder-not-a-key
AZURE_CLIENT_ID=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
LOG_LEVEL=info
