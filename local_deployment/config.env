# ─────────────────────────────────────────────────────────────────────────────
#  PacEHR local deployment — the single place to change settings.
#  Every script in scripts/ reads this file. Edit values here, never in the
#  scripts themselves. Nothing here touches the PacEHR or pacEHR_API repos.
# ─────────────────────────────────────────────────────────────────────────────

# ── Where the three source repos live ───────────────────────────────────────
# Relative paths are resolved against this local_deployment folder. The default
# layout is the team workspace:
#     <workspace>/PacEHR  pacEHR_API  PacEHR_AI  sai-systems-AIRE/local_deployment
# so the repos are two levels up from here. If your clones live elsewhere, do NOT
# edit this file: copy config.local.env.example to config.local.env (git-ignored)
# and override the values there, or export them for one run:
#     API_REPO=/abs/path/pacEHR_API ./deploy.sh --api-only
API_REPO="${API_REPO:-../../pacEHR_API}"
WEB_REPO="${WEB_REPO:-../../PacEHR}"

# ── Image names (what "podman images" will show) ────────────────────────────
API_IMAGE="pacehr-api-local:latest"
WEB_IMAGE="pacehr-web-local:latest"

# ── Container names (what Podman Desktop will show) ─────────────────────────
API_CONTAINER="pacehr-api"
WEB_CONTAINER="pacehr-web"
NETWORK="pacehr-local"

# ── Host ports — change these if something else already uses them ───────────
API_PORT="8080"     # → http://localhost:8080/swagger
WEB_PORT="4200"     # → http://localhost:4200

# ── API runtime ─────────────────────────────────────────────────────────────
# Picks which appsettings.<env>.json the API loads at startup.
# Development → the DEV Azure SQL database (pacehr_dev_sqldb).
# Valid: Development | QA | Uat | Test | Automation | Production
ASPNETCORE_ENV="Development"

# ── Frontend build ──────────────────────────────────────────────────────────
# The API base URL the *browser* will call. Default points at the API container
# published above. To make the UI talk to the cloud DEV API instead, set:
#   WEB_API_BASE_URL="https://pacehr-d-api-app-hua2f3gjedhmgtfd.eastus2-01.azurewebsites.net"
WEB_API_BASE_URL="http://localhost:8080"

# Angular build configuration from the frontend's angular.json.
# "staging" is what the Azure pipeline builds for every non-production environment:
# optimized, no budgets, and it keeps src/environments/environment.ts (real DEV blob
# and SignalR endpoints). Leave EMPTY for an unoptimized build of the same file.
# Setting "production" swaps in environment.prod.ts, which points at PRODUCTION
# blob storage and has an unresolved __apiBaseUrl__ token that CI normally fills in.
# Valid: "" | production | uat | test | demo | automation | staging
WEB_BUILD_CONFIG="staging"

# Minify/optimize the Angular bundle. "true" = slower build, fast page loads.
# "false" = quicker build, large bundle, sluggish first paint.
WEB_OPTIMIZE="true"

# Base images. node:22 matches Angular 18's supported Node range.
NODE_IMAGE="docker.io/library/node:22-alpine"
NGINX_IMAGE="docker.io/library/nginx:alpine"

# ── PacEHR_AI (TypeScript encounter agent, compiled to dist/ in the image) ──
AI_REPO="${AI_REPO:-../../PacEHR_AI}"
AI_IMAGE="pacehr-ai-local:latest"
AI_TEST_IMAGE="pacehr-ai-test-local:latest"
AI_CONTAINER="pacehr-ai"
AI_PORT="3000"      # → http://localhost:3000/health

# The service's settings (Azure OpenAI, Azure SQL, Entra). Read, never written:
# create it once with  cp ../../PacEHR_AI/.env.example ../../PacEHR_AI/.env.local
# and fill it in. Passed to the container as environment variables, so write
# values unquoted (KEY=value): podman keeps quote characters as part of the value.
# Override for one run without editing this file, e.g. the non-secret placeholders:
#   AI_ENV_FILE=ai.placeholder.env ./deploy.sh --ai-only
AI_ENV_FILE="${AI_ENV_FILE:-../../PacEHR_AI/.env.local}"

# PacEHR_AI's package.json engines: Node >= 22.13.
AI_NODE_IMAGE="docker.io/library/node:22-alpine"
